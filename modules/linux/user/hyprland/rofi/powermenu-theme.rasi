@theme "theme"

configuration {
    show-icons: false;
}

window {
    location: center;
    anchor: center;
    y-offset: 0;
    width: 360px;
}

mainbox {
    children: [ inputbar, listview ];
}

inputbar {
    children: [ prompt ];
}

listview {
    lines: 5;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
}

element-text {
    vertical-align: 0.5;
}
